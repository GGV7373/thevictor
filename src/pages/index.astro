---
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import '../styles/home.css';

interface Project {
  title: string;
  desc: string;
  tags?: string[];
  link?: string;
  linkText: string;
}

const projectsFile = resolve(process.cwd(), 'public', 'data', 'projects.json');
const { projects } = JSON.parse(await readFile(projectsFile, 'utf-8')) as { projects: Project[] };
const featured = projects.slice(0, 3);
const totalProjects = projects.length;

const kindOf = (p: Project) =>
  (p.tags ?? []).includes('team-collaboration') ? 'Collaboration' : 'Project';
const stackOf = (p: Project) =>
  (p.tags ?? [])
    .filter(t => t !== 'team-collaboration')
    .map(t => t.split('-').map(s => s.charAt(0).toUpperCase() + s.slice(1)).join(' '))
    .join(' · ');
---

<Layout
  title="Home"
  description="Victor Husefest is a software developer and IT consultant based in Norway, building practical tools, automation workflows, and web projects."
>
  <Hero />

  <section id="home-work">
    <div class="container">
      <div class="home-work-head">
        <h2 class="home-work-title">Recent work</h2>
        <a href="/projects" class="home-work-all">All {totalProjects} projects &rarr;</a>
      </div>

      <div class="home-work-grid">
        {featured.map(p => (
          <a href={p.link ?? '/projects'} class="home-work-card" target={p.link?.startsWith('http') ? '_blank' : undefined} rel={p.link?.startsWith('http') ? 'noopener noreferrer' : undefined}>
            <span class="home-work-kind">{kindOf(p)}</span>
            <span class="home-work-name">{p.title}</span>
            <span class="home-work-desc">{p.desc}</span>
            <span class="home-work-stack">{stackOf(p)}</span>
          </a>
        ))}
      </div>

      <div class="home-nav-grid">
        <a href="/qualifications" class="home-nav-card">
          <span>
            <span class="home-nav-eyebrow">Tech competence</span>
            <span class="home-nav-title">Qualifications</span>
          </span>
          <span class="home-nav-arrow">&rarr;</span>
        </a>
        <a href="/contact" class="home-nav-card">
          <span>
            <span class="home-nav-eyebrow">Get in touch</span>
            <span class="home-nav-title">Contact</span>
          </span>
          <span class="home-nav-arrow">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import '../scripts/smooth-scroll.ts';
</script>
