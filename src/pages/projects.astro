---
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import Layout from '../layouts/Layout.astro';

interface Project {
  title: string;
  desc: string;
  tags?: string[];
  link?: string;
  linkText: string;
}

const projectsFile = resolve(process.cwd(), 'public', 'data', 'projects.json');
const { projects } = JSON.parse(await readFile(projectsFile, 'utf-8')) as { projects: Project[] };
---

<Layout
  title="Projects"
  description="Browse projects by Victor Husefest, including AI tools, automation scripts, portfolio work, and team collaborations."
  pageClass="projects-page"
>
  <section id="projects" class="projects-page-shell">
    <div class="container">
      <div class="section-heading projects-header">
        <div>
          <p class="section-eyebrow">Selected work &middot; {projects.length} projects</p>
          <h1 class="section-title">Projects</h1>
        </div>
        <label class="projects-search">
          <span class="projects-search-icon" aria-hidden="true">&#8981;</span>
          <input
            type="text"
            class="projects-search-input"
            placeholder="Search by name, tech or tag"
            id="projects-search-input"
            aria-label="Search projects"
          />
        </label>
      </div>

      <div class="project-filters" id="project-filters"></div>

      <div class="projects-content-area">
        <div class="projects-grid" id="projects-grid"></div>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ projects }}>
  window.__PROJECTS_DATA__ = projects;
</script>

<script>
  import '../scripts/projects.ts';
</script>
