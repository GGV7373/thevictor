---
---

<section id="hero">
  <div class="container hero-inner">
    <div class="hero-portrait">
      <img src="/me.webp" alt="Victor Husefest" loading="eager" class="hero-portrait-img" />
    </div>

    <div class="hero-body">
      <p class="hero-kicker">Victor Husefest &middot; Norway</p>
      <h1 class="hero-name">I build web apps, servers and automation that quietly do the work.</h1>
      <p class="hero-desc">
        Software developer and IT consultant based in Norway. I work end-to-end:
        deploying web applications, setting up cloud infrastructure and CI/CD, and
        folding AI and automation into workflows that already exist.
      </p>

      <div class="hero-stats">
        <div class="hero-stat">
          <span class="hero-stat-label">Based in</span>
          <span class="hero-stat-value">Norway &middot; CET</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-label">Focus</span>
          <span class="hero-stat-value">Software &middot; automation &middot; infrastructure</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-label">Availability</span>
          <span class="hero-stat-value hero-stat-value--live">
            <span class="hero-dot"></span>Available for select freelance projects
          </span>
        </div>
      </div>

      <div class="hero-actions">
        <a href="/projects" class="btn">See the work</a>
        <a href="/contact" class="btn btn-outline">Get in touch</a>
      </div>
    </div>
  </div>
</section>
