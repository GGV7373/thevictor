---
interface Props {
  detailed?: boolean;
}

const GITHUB = 'https://github.com/GGV7373';
const LINKEDIN = 'https://www.linkedin.com/in/victor-husefest-6372843aa/';
const EMAIL = 'mailto:thevictor-con@outlook.com';

const canHelp = [
  'Building and deploying web applications end-to-end',
  'Setting up servers, cloud infrastructure and CI/CD pipelines',
  'Integrating AI and automation into existing workflows',
  'Advising on tech stack choices and architecture decisions',
];

const openFor = [
  'Freelance & Contract Work',
  'Full-time Opportunities',
  'Collaboration Projects',
  'Tech Discussions & Ideas',
  'Consulting',
  'General Inquiries',
];
---

<section id="contact">
  <div class="container contact-grid">
    <div class="contact-main">
      <div class="contact-status">
        <span class="contact-status-dot"></span>Open for work
      </div>
      <h1 class="contact-title">Get in touch</h1>
      <p class="contact-lead">
        Freelance, contract or full-time &mdash; send a line about what you need
        and I&rsquo;ll reply within 24&ndash;48 hours.
      </p>

      <div class="contact-cta-buttons">
        <a href={EMAIL} class="contact-email-btn">Send me an email<span aria-hidden="true">&rarr;</span></a>
        <div class="contact-cta-row">
          <a href={GITHUB} class="contact-social-btn" target="_blank" rel="noopener noreferrer">
            <img src="/logo-github.webp" alt="" />GitHub
          </a>
          <a href={LINKEDIN} class="contact-social-btn" target="_blank" rel="noopener noreferrer">
            <img src="/logo-linkedin.webp" alt="" />LinkedIn
          </a>
        </div>
        <p class="contact-response-note">For urgent matters, LinkedIn is fastest.</p>
      </div>
    </div>

    <aside class="contact-side-card">
      <p class="contact-side-label">What I can help with</p>
      <ul class="contact-can-help-list">
        {canHelp.map(item => <li>{item}</li>)}
      </ul>

      <p class="contact-side-label">Open for</p>
      <div class="contact-open-pills">
        {openFor.map(item => <span class="contact-pill">{item}</span>)}
      </div>
    </aside>
  </div>
</section>
